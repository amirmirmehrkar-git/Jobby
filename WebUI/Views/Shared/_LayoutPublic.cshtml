                <div>
                    <i style="color:blue" class="ti ti-users"></i>
                </div>
                <div class="step-desc">
                    Users
                </div>
            </div>
            <div ng-class="{'selectSection':$root.adminSelectedBlogs}"
                 ng-click="vm.goTo('/admin/blogs')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-news"></i>
                </div>
                <div class="step-desc">
                    Blogs
                </div>
            </div>
            <div ng-class="{'selectSection':$root.adminSelectedSetting}"
                 ng-click="vm.goTo('/admin/setting')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-settings"></i>
                </div>
                <div class="step-desc">
                    Setting
                </div>
            </div>
            <div ng-class="{'selectSection':$root.adminSelectedTicket}"
                 ng-click="vm.goTo('/admin/tickets')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-headset"></i>
                </div>
                <div class="step-desc">
                    Ticket
                </div>
            </div>
        </nav>

        <div style="float:right!important">
            <a style="padding:8px 12px!important" class="box3 btn primary" href="#!/user/setting">
                {{vm.UserFullName}}
                <i class="ti ti-user"></i>
            </a>
            <a style="padding:8px 12px!important" class="box3 btn ghost" href="@Url.Action("logoff", "account", new { area = "" })">
                Logout
                <i class="ti ti-door-exit"></i>
            </a>
        </div>

    </header>

    <div class="col-12">
        @RenderBody()
    </div>

    <div ng-controller="profileController as vm"
         class="modal fade" id="seePositionsModal" tabindex="-1" aria-labelledby="addOrUpdateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="close"></button>
                </div>

                <div class="modal-body text-center">
                    <div style="margin-right: 20px;margin-left: 20px;" class="row">
                        <div ng-class="{'my_highlight': row.IsSelected}"
                            ng-click="vm.selectPosition(row.Id)" ng-repeat="row in $root.positions"
                             style="margin-bottom: 10px;cursor: pointer; border: 1px solid lightpink" class="box4 step-card">
                            <div class="step-title">{{row.Title}}</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="box3 btn ghost" data-bs-dismiss="modal">Close</button>
                </div>

            </div>
        </div>
    </div>

    <footer id="mainFooter" class="site-footer" role="contentinfo">
        <div style="text-align:center">
            <div class="step-title" style="margin-bottom:5px;font-weight:800">Easy Actions</div>
            <div style="margin-bottom:12px;font-weight:400;font-size:10px">Your AI career co-pilot</div>
            <p class="small">© 2024 Easy Actions. All rights reserved. Made with ❤️ for ambitious professionals.</p>
            <div style="margin-top:12px;display:flex;gap:14px;justify-content:center">
                <a href="#" style="color:var(--muted);text-decoration:none;font-weight:700">Privacy</a>
                <a href="#" style="color:var(--muted);text-decoration:none;font-weight:700">Terms</a>
                <a href="#" style="color:var(--muted);text-decoration:none;font-weight:700">Contact</a>
            </div>
        </div>
    </footer>

