<body>

    <span us-spinner="{radius:30, width:8, length: 16}">
    </span>
    <div id="loaderContainer" ng-show="spinnerActive">
        <div class="loaderLogo">
            <div class="loader">
            </div>
        </div>
    </div>

    <div class="my_bg"></div>
    <div class="my_bg my_bg2"></div>
    <div class="my_bg my_bg3"></div>

    <header style="display:none" id="publicMenu" class="site-header">
        <a class="brand">
            <div class="logo-mark">
                <img src="/images/logo.png" style="height:40px">
            </div>

            <div class="logo-all">
                <div class="step-title" style="margin-bottom:5px;font-weight:800">Easy Actions</div>
                <div class="logoBottomTitle">Your AI career co-pilot</div>
            </div>
        </a>

        <nav class="top-nav" role="navigation" aria-label="Main Navigation">

            <a style="font-family: Segoe UI!important;font-size:17px!important" class="box4" href="#features">Why Jobby</a>
            <a style="font-family: Segoe UI!important;font-size:17px!important" class="box4" href="#platforms">How It Works</a>
            <a style="font-family: Segoe UI!important;font-size:17px!important" class="box4" href="#!/blogs">Blogs</a>

            <a class="box3 btn ghost" href="#pricing">
                Pricing
                <i class="ti ti-coin"></i>
            </a>
            <a class="box3 btn primary" href="#!/login">
                Get Started Free
                <i class="ti ti-arrow-right"></i>
            </a>
        </nav>
    </header>

    <header ng-controller="profileController as vm" ng-init="vm.initializeController()"
            style="display:none;padding-left:15px!important;padding-right:15px!important" id="userMenu" class="site-header">
        <a class="brand">
            <div class="logo-mark">
                <img src="/images/logo.png" style="height:40px">
            </div>

            <div class="logo-all">
                <div class="step-title" style="margin-bottom:5px;font-weight:800">Easy Actions</div>
                <div class="logoBottomTitle">Your AI career co-pilot</div>
            </div>
        </a>

        <nav class="top-nav" role="navigation" aria-label="Main Navigation">

            <div ng-click="vm.goTo('/user/dashboard')" ng-class="{'selectSection':$root.selectedDashboard}"
                 class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-home"></i>
                </div>
                <div class="step-desc">
                    Home
                </div>
            </div>
            <div ng-click="vm.goTo('/user/jobTracker')" ng-class="{'selectSection':$root.selectedJobTracker}"
                 class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-search"></i>
                </div>
                <div class="step-desc">
                    Job Tracker
                </div>
            </div>
            <div ng-class="{'selectSection':$root.selectedDocuments}"
                 ng-click="vm.goTo('/user/documents')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-file"></i>
                </div>
                <div class="step-desc">
                    Documents
                </div>
            </div>
            <div ng-class="{'selectSection':$root.selectedEmailCenter}"
                 ng-click="vm.goTo('/user/emailCenter')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-calendar"></i>
                </div>
                <div class="step-desc">
                    Email Center
                </div>
            </div>
            <div ng-class="{'selectSection':$root.selectedSetting}"
                 ng-click="vm.goTo('/user/setting')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-settings"></i>
                </div>
                <div class="step-desc">
                    Settings
                </div>
            </div>
            <div ng-class="{'selectSection':$root.selectedTicket}"
                 ng-click="vm.goTo('/user/tickets')" class="box4" style="text-align:center!important;margin-right: 15px;">
                <div>
                    <i style="color:blue" class="ti ti-headset"></i>
                </div>
                <div class="step-desc">
                    Ticket
                </div>
            </div>
        </nav>

        <div style="float:right!important">
            <a style="padding:8px 12px!important" class="box3 btn primary"
               ng-click="vm.getUserPositions()"
               data-dismiss="modal" data-bs-toggle="modal" data-bs-target="#seePositionsModal">
                {{vm.UserFullName}}
                <i class="ti ti-user"></i>
            </a>
            <a style="padding:8px 12px!important" class="box3 btn ghost" href="@Url.Action("logoff", "account", new { area = "" })">
                Logout
                <i class="ti ti-door-exit"></i>
            </a>
        </div>

    </header>

    <header ng-controller="profileController as vm" ng-init="vm.initializeController()"
            style="display:none;padding-left:15px!important;padding-right:15px!important" id="adminMenu" class="site-header">
