    <style>
        /* شناور پایین راست */
        .chat-icon {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 85px;
            height: 85px;
            background: linear-gradient(135deg, #EA4296, #5F33E5);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            cursor: pointer;
            transition: transform 0.3s ease;
            z-index: 999;
        }

            .chat-icon:hover {
                transform: scale(1.1);
            }

        /* پنجره چت */
        .chat-box {
            position: fixed;
            bottom: 100px;
            right: 25px;
            width: 800px;
            height: 500px;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1000;
        }

        .chat-header {
            background: linear-gradient(90deg, #5F33E5, #EA4296);
            padding: 12px 15px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .chat-header h3 {
                margin: 0;
                font-size: 16px;
                font-weight: 600;
            }

            .chat-header small {
                font-size: 12px;
                color: rgba(255,255,255,0.9);
            }

        .chat-content {
            flex: 1;
            background: #fffaf3;
            padding: 15px;
            overflow-y: auto;
        }

        .bot-message {
            background: #fff;
            border: 1px solid #ffe2a6;
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 10px;
            color: #444;
        }

        .chat-footer {
            background: #fff;
            border-top: 1px solid #ddd;
            padding: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .chat-footer input {
                flex: 1;
                border: none;
                outline: none;
                padding: 8px 12px;
                border-radius: 20px;
                background: #f5f5f5;
                font-size: 14px;
            }

            .chat-footer button {
                background: linear-gradient(135deg, #EA4296, #5F33E5);
                border: none;
                color: white;
                border-radius: 50%;
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
            }

        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

            .quick-actions button {
                background: #fff;
                border: 1px solid #ffce73;
                border-radius: 8px;
                padding: 5px 10px;
                font-size: 13px;
                cursor: pointer;
                color: #5F33E5;
                transition: background 0.3s;
            }

                .quick-actions button:hover {
                    background: #ffebc2;
                }
    </style>

    <div class="chat-icon" id="chatIcon">
        <div style="border:0px!important" class="logo-mark">
            <img src="/images/logochatbot.png" style="height:75px">
        </div>
    </div>

    <div class="chat-box" id="chatBox">
        <div class="chat-header">
            <div>
                <h3>Jobby - AI Career Co-pilot</h3>
                <small>Easy Actions Help Center</small>
            </div>
            <span style="cursor:pointer;" onclick="toggleChat()">✖</span>
        </div>

        <div class="chat-content" id="chatContent">
            <div class="bot-message">
                Hello! I'm Jobby, your AI career co-pilot! 🚀 I can help you in any language
                with resume uploads, job applications, cover letters, and navigating
                the entire Easy Actions platform. What would you like to know?
            </div>

            <div class="quick-actions">
                <button>Start Visual Tutorial</button>
                <button>Upload Resume</button>
                <button>Job Matching</button>
            </div>
        </div>

        <div class="chat-footer">
            <input type="text" placeholder="Ask Jobby anything about Easy Actions..." />
            <button>➤</button>
        </div>
    </div>

    <script>
        const chatIcon = document.getElementById("chatIcon");
        const chatBox = document.getElementById("chatBox");

        chatIcon.addEventListener("click", () => {
          chatBox.style.display = chatBox.style.display === "flex" ? "none" : "flex";
        });

        function toggleChat() {
          chatBox.style.display = "none";
        }
    </script>


    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/toastr.min.js"></script>
    <script src="/js/myJavaScripts.js"></script>
    <script src="/js/angularjs/angular.js"></script>
    <script src="/js/angularjs/angular-route.js"></script>
    <script src="/js/ng-table.min.js"></script>
